## Syntax highlighting for .env files (KEY=value), linked to ~/.nano/ by install.sh
syntax env "(^|/)(\.env(\.[^/]*)?|[^/]*\.env|\.envrc|\.flaskenv)$"
comment "#"

# Values: everything after the first =
color yellow "=.*$"
# Quoted strings
color brightgreen ""(\\.|[^"])*"" "'[^']*'"
# Variable references: ${VAR} and $VAR
color brightmagenta "\$\{[A-Za-z_][A-Za-z0-9_]*\}" "\$[A-Za-z_][A-Za-z0-9_]*"
# Keys, with optional `export`
color brightcyan "^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_.-]*[[:space:]]*="
color brightblue "^[[:space:]]*export\>"
# Comments: whole lines, and " # ..." after a value
color brightblack "^[[:space:]]*#.*$" "[[:space:]]#.*$"
# Trailing whitespace
color ,red "[[:space:]]+$"
